# Copy to .env.local for development. In production set these in the host's environment (on Vercel: Project Settings, Environment Variables).
# See docs/hosted-deploy.md for how each one pairs with a setting of the Python API.

# The auth database. The role should own only the `auth` schema.
DATABASE_URL=postgresql://scraper_web:change-me@localhost:5432/scraper

# At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=

# This app's public address, no trailing slash. Must be https in production.
BETTER_AUTH_URL=http://localhost:3000

# The Python API: where to send account deletions, and the audience its tokens are issued for.
API_URL=http://localhost:8080
# API_AUDIENCE=http://localhost:8080        # defaults to API_URL; must equal the API's SCRAPER_JWT_AUDIENCE

# A long random string, identical to the API's SCRAPER_SERVICE_SECRET.
SERVICE_SECRET=

# Email. In development, `log` prints invitation and verification links to this terminal.
EMAIL_TRANSPORT=log
# In production: EMAIL_TRANSPORT=resend, with
# RESEND_API_KEY=re_...
# EMAIL_FROM=Page Chat <no-reply@your-verified-domain.example>

# The one address that may sign up without an invitation, and only while there is no administrator.
ADMIN_EMAIL=

# Optional: other origins allowed to call the auth API (comma-separated), and how long an invitation lasts.
# TRUSTED_ORIGINS=https://preview.example.vercel.app

# If another proxy or CDN sits in front of this app (Vercel alone does not count), list its addresses or ranges, comma-separated, so that
# rate limits are kept per visitor and not for everyone together. Leave it out when the app is reached directly.
# TRUSTED_PROXIES=
# INVITE_TTL_DAYS=7

# ---- Only for tests ---------------------------------------------------------------------------------------------------------------
# A scratch database for `npm test`. Its `auth` schema is dropped and recreated, so its name must contain "test". Unset is an error, not a skip.
# WEB_TEST_DATABASE_URL=postgresql://user@localhost/scraper_web_test
# A second scratch database for `npm run e2e` and `npm run e2e:ui`. Its `auth` and `app` schemas are dropped.
# E2E_DATABASE_URL=postgresql://user@localhost/scraper_e2e_test
