# Copy to .env (git ignores it) and fill in what you need. The web app has its own file: web/.env.example.
# Real environment variables override anything set here. See docs/hosted-deploy.md for how each setting pairs with the web app's.
# Defaults are shown after each setting. A line that starts with # is optional; the others are needed for a hosted deployment.

# ---- Hosted mode (required) ------------------------------------------------------------------------------------------
# The API refuses to start without it.
SCRAPER_HOSTED=true
# The role should own only the `app` schema, so the API cannot read the web app's password hashes.
SCRAPER_DATABASE_URL=postgresql://scraper_api:change-me@localhost:5432/scraper
# Where the web app publishes its signing keys, and the issuer and audience its tokens carry. They must equal the web app's
# BETTER_AUTH_URL (issuer) and API_AUDIENCE (audience, which defaults to its API_URL), with no trailing slash.
SCRAPER_JWKS_URL=http://localhost:3000/api/auth/jwks
SCRAPER_JWT_ISSUER=http://localhost:3000
SCRAPER_JWT_AUDIENCE=http://localhost:8080
# A long random string, identical to the web app's SERVICE_SECRET. Lets the web app erase a person's data when they delete an account.
SCRAPER_SERVICE_SECRET=
# Comma-separated browser origins allowed to call the API: the web app's own address.
SCRAPER_CORS_ORIGINS=http://localhost:3000
# SCRAPER_CORS_ORIGIN_REGEX=https://app-.*\.vercel\.app    # optional pattern, for preview deployments

# ---- Model server ----------------------------------------------------------------------------------------------------
# Which model server the API uses: mistral (the default when hosted; needs a key) or lmstudio (a server you run yourself, no key needed).
# SCRAPER_PROVIDER=mistral
# Your Mistral key. MISTRAL_API_KEY works too. With Mistral, the text of every page the model reads is sent to Mistral's servers.
SCRAPER_API_KEY=
# SCRAPER_MISTRAL_BASE_URL=https://api.mistral.ai/v1
# Used when SCRAPER_PROVIDER=lmstudio. LM Studio's server, or any server with the same API.
# SCRAPER_BASE_URL=http://localhost:1234/v1
# Comma-separated model ids people may choose; empty means any the provider lists. Set it to keep costs predictable.
# SCRAPER_ALLOWED_MODELS=
# Context size assumed when the model does not report one (16384).
# SCRAPER_FALLBACK_CONTEXT=16384

# ---- Where it listens ------------------------------------------------------------------------------------------------
# SCRAPER_HOST=127.0.0.1
# SCRAPER_PORT=8080

# ---- Limits per person and for the whole server ----------------------------------------------------------------------
# Per person per UTC day.
# SCRAPER_DAILY_MODEL_CALLS=300
# SCRAPER_DAILY_PAGES=300
# Stored for each person; longer page text is cut.
# SCRAPER_MAX_STORED_PAGES=60
# SCRAPER_MAX_PAGE_CHARS=200000
# SCRAPER_MAX_RESULT_ROWS=2000
# Runs streaming at once across everyone: the API is one process.
# SCRAPER_MAX_CONCURRENT_RUNS=5
# Per person, on routes that do not stream.
# SCRAPER_REQUESTS_PER_MINUTE=120

# ---- Fetching pages --------------------------------------------------------------------------------------------------
# Comma-separated from fast, dynamic, stealthy. Empty means only fast when hosted. Browser modes need browsers installed and limits first.
# SCRAPER_FETCH_MODES=
# Seconds per page, and the minimum pause between fetches (the model may raise it, never go below it).
# SCRAPER_FETCH_TIMEOUT=20
# SCRAPER_REQUEST_DELAY=0.5
# Reading a page together with the pages it links to.
# SCRAPER_CRAWL_MAX_PAGES=20
# SCRAPER_CRAWL_DEPTH=1

# ---- The agent -------------------------------------------------------------------------------------------------------
# Per round, before it pauses to ask what to do.
# SCRAPER_AGENT_MAX_STEPS=25
# SCRAPER_AGENT_MAX_PAGES=30
# Size cap for each tool result, in tokens.
# SCRAPER_TOOL_RESULT_TOKENS=3000
# How much of the model's context window each part of a prompt may use.
# SCRAPER_CONTEXT_FRACTION=0.7
# SCRAPER_REPLY_RESERVE=2048
# SCRAPER_HISTORY_RESERVE=3000

# ---- Only for the local compose stack (podman-compose up --build) and for tests ----------------------------------------------------
# POSTGRES_PASSWORD=
# A scratch database the Python tests may fill and empty (its name should contain "test"). Without it the Postgres tests are skipped.
# SCRAPER_TEST_DATABASE_URL=postgresql://user@localhost/scraper_test
