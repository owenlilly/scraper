# Copy to .env (git ignores it) and fill in what you need.
# Real environment variables override anything set here.

# Setting a Mistral key adds Mistral to the Provider dropdown. MISTRAL_API_KEY works too.
# With Mistral selected, page text is sent to Mistral's servers.
SCRAPER_API_KEY=

# Which provider the app starts on: lmstudio (default, local) or mistral (needs the key above)
# SCRAPER_PROVIDER=lmstudio

# SCRAPER_BASE_URL=http://localhost:1234/v1          # LM Studio
# SCRAPER_MISTRAL_BASE_URL=https://api.mistral.ai/v1
# SCRAPER_PORT=8080
